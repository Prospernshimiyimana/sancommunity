# SanCommunity — local environment template
#
# Copy to .env.local and fill in the values:   cp .env.local.example .env.local
# .env.local is gitignored. Never commit real values.
# Never put a service-account JSON file inside this project.

# ---------------------------------------------------------------
# Firebase Web SDK (client)
# ---------------------------------------------------------------
# Firebase Console -> Project settings -> General -> Your apps -> Web app -> SDK setup

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------------------------------------------------------------
# Firebase Admin SDK (local scripts only — e.g. npm run seed:houses)
# ---------------------------------------------------------------
# Absolute path to a service-account JSON stored OUTSIDE this project.
# Example: /Users/<you>/.secrets/firebase-service-account.json
# Not needed to run the app; only for scripts/seed-sancommunity-houses.ts.

GOOGLE_APPLICATION_CREDENTIALS=

# Alternative for environments without a filesystem.
# Never prefix this with NEXT_PUBLIC_.
#
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional project override.
#
# FIREBASE_PROJECT_ID=

# ---------------------------------------------------------------
# Not wired up yet
# ---------------------------------------------------------------
# NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=